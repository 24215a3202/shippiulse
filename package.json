{
  "name": "shippulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web,worker -c blue,green,yellow \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:worker\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:worker": "npm --workspace backend run worker",
    "build": "npm --workspace frontend run build",
    "test": "npm --workspace backend run test",
    "db:migrate": "npm --workspace backend run db:migrate",
    "check": "npm --workspace backend run check && npm --workspace frontend run check"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
