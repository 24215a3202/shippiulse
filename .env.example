NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Set these to a PostgreSQL database and user you control.
DATABASE_URL=postgresql://shippulse:change-me@127.0.0.1:5432/shippulse
DATABASE_SSL=false

# Redis is used by background processing in later phases.
REDIS_URL=redis://127.0.0.1:6379

# Phase 8 exception scanning thresholds
EXCEPTION_SCAN_INTERVAL_SECONDS=60
EXCEPTION_DELIVERY_GRACE_MINUTES=30
EXCEPTION_PICKUP_DELAY_MINUTES=30
EXCEPTION_MISSING_GPS_MINUTES=15
EXCEPTION_ROUTE_DEVIATION_METERS=1000
EXCEPTION_STOP_DELAY_MINUTES=45
EXCEPTION_ESCALATION_MINUTES=60

# Optional in development. Production must use independently generated secrets and SMTP.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SMTP_URL=
SMTP_FROM=ShipPulse <no-reply@example.com>
